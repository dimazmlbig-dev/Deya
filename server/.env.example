# Telegram bot token
TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# Firebase RTDB url (как в твоём конфиге)
FIREBASE_DATABASE_URL=https://artemkadriver-default-rtdb.europe-west1.firebasedatabase.app

# optional: сколько живёт initData (сек)
TG_INITDATA_MAX_AGE_SEC=86400

# PORT
PORT=8080

# Один из двух способов для firebase-admin:

# Способ A: файл сервисного аккаунта:
# export GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Способ B: JSON сервис-аккаунта одной строкой:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}